# Environment Configuration
# Copy this file to .env.local for local development or .env.production for deployment.

# MongoDB Connection String
MONGODB_URI=mongodb://127.0.0.1:27017/malashree

# Cryptographic Secret for JWT Generation (Must be strong and secure in production)
JWT_SECRET=supersecretjwtkey_for_local_dev_only

# Razorpay Credentials (Optional for local dev, required for online payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Public URL (Used for Webhooks and absolute path generation)
NEXT_PUBLIC_APP_URL=http://localhost:3000
